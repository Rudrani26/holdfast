# Holdfast environment variables (docs/ARCHITECTURE.md §10).
# Copy to .env.local and fill in real values there. Never commit real values.
# Placeholders only in this file.

# --- App ---
APP_BASE_URL=http://localhost:3000
# Shows "Sandbox demo — no real money"
DEMO_BANNER=true

# --- PayPal (Sandbox only; the app refuses to start unless this is "sandbox") ---
PAYPAL_ENV=sandbox
# Server only
PAYPAL_CLIENT_ID=<sandbox-client-id>
PAYPAL_CLIENT_SECRET=<sandbox-client-secret>
# Same value as PAYPAL_CLIENT_ID; exposed to the browser for the JS SDK
NEXT_PUBLIC_PAYPAL_CLIENT_ID=<sandbox-client-id>
# From the sandbox app's webhook configuration
PAYPAL_WEBHOOK_ID=<sandbox-webhook-id>
# PARTIAL_CAPTURE_THEN_VOID | PARTIAL_CAPTURE_FINAL | CAPTURE_THEN_REFUND (set from spike results, T-006)
SETTLEMENT_MODE=PARTIAL_CAPTURE_THEN_VOID

# --- Google Cloud ---
GCP_PROJECT_ID=<gcp-project-id>
GCP_REGION=us-central1
# dev_ locally, empty in the demo deployment
FIRESTORE_COLLECTION_PREFIX=dev_
GCS_BUCKET=<gcs-bucket-name>

# --- AI ---
# us-central1, or global if the pinned model requires it
VERTEX_LOCATION=us-central1
# Pinned in T-007
GEMINI_MODEL=<pinned-in-T-007>
# Pinned in T-051 (eval generation only)
IMAGE_EDIT_MODEL=<pinned-in-T-051>
# live | replay
AI_MODE=live
AI_DAILY_CALL_LIMIT=300

# --- Auth ---
STAFF_PASSCODE=<staff-passcode>
# 32+ random bytes each, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
SESSION_SECRET=<32-plus-random-bytes>
RENTER_LINK_SECRET=<32-plus-random-bytes>
